# HTTP server
# HOST controls native process listening and the default Compose host publishing
# for both the main service and provider OAuth callback ports. Keep it on
# loopback unless external access is protected.
HOST=127.0.0.1
PORT=3001
# Timeouts are seconds; the Compose stop grace period uses a duration.
GRACEFUL_SHUTDOWN_TIMEOUT=10
CONTAINER_STOP_GRACE_PERIOD=15s
READ_TIMEOUT=60
IDLE_TIMEOUT=120

# Storage
# Empty DATABASE_DSN uses ${DATA_DIR}/gpt-load.db. Otherwise set a SQLite,
# MySQL, or PostgreSQL URL; container file paths must use mounted paths.
DATA_DIR=./data
DATABASE_DSN=

# Security
# AUTH_KEY defaults to DATA_DIR/auth.key. Back it up with the database.
# ENCRYPTION_KEY is an explicit override for controlled environments/CI.
# Otherwise the encryption master key lives in macOS Keychain or Linux Secret Service.
AUTH_KEY=
ENCRYPTION_KEY=

# Explicit headless mode: BOTH settings are required. Keep the owner-only age
# identity file outside DATA_DIR and back it up separately from the database.
# Encrypted custody is DATA_DIR/encryption.key.age, not a plaintext key.
# DEMERZEL_ENCRYPTION_KEY_AGE_IDENTITY_FILE=/private/keys/demerzel-age-identity.txt
# DEMERZEL_ENCRYPTION_KEY_AGE_RECIPIENT=age1...

# One-time legacy import only, after backing up DATA_DIR/encryption.key and DB.
# The source key file is never removed by Demerzel; delete it manually only after
# checking a restart against a backed-up copy with the new custody backend.
# DEMERZEL_ENCRYPTION_KEY_IMPORT_LEGACY=1

# External DATABASE_DSN: a missing custody key fails closed. Only for a
# separately verified EMPTY database, explicitly initialize its first key
# once, then unset this switch before subsequent restarts.
# DEMERZEL_ENCRYPTION_KEY_INITIALIZE_EXTERNAL=1

# Startup proxy fallback; restart after changes.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Optional process opt-in; automated Models.dev synchronization is off by default.
# Set true to allow startup, periodic, and group-change catalog syncs.
# MODELS_DEV_AUTO_SYNC_ENABLED=true
